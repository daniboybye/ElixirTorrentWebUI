<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Keep in lockstep with mix.exs and the .csproj version properties. -->
  <assemblyIdentity version="0.4.0.0" name="ElixirTorrentWebUI.Launcher" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Never elevate. All state is per-user. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- The only GUID Microsoft ships for Windows 10 and 11 alike. The real
           Windows 11 floor is SupportedOSPlatformVersion 10.0.22000 in the
           .csproj; build 22000 is Windows 11 RTM. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Long path support (opt-in). Deliberately NO dpiAware/dpiAwareness:
           WinUI 3 sets the process DPI context itself and fail-fasts inside
           Microsoft.UI.Input.dll if the manifest already declared one. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
